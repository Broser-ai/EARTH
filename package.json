{
  "name": "earth-sovereign",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 5180",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint eslint.config.js prettier.config.js vitest.config.ts test packages/earth-contracts/src",
    "lint:fix": "eslint eslint.config.js prettier.config.js vitest.config.ts test packages/earth-contracts/src --fix",
    "lint:src": "eslint src",
    "format": "prettier --write eslint.config.js prettier.config.js vitest.config.ts test packages/earth-contracts docs/QUALITY_BASELINE.md",
    "format:check": "prettier --check eslint.config.js prettier.config.js vitest.config.ts test packages/earth-contracts docs/QUALITY_BASELINE.md",
    "api:dev": "npm --prefix apps/api run dev",
    "api:build": "npm --prefix apps/api run build",
    "api:test": "npm --prefix apps/api run test",
    "api:typecheck": "npm --prefix apps/api run typecheck",
    "db:migrate": "npm --prefix apps/api run migrate"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "motion": "^12.12.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
