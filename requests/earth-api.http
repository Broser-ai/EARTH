@baseUrl = http://localhost:3001
@orgId = 11111111-1111-1111-1111-111111111111
@userId = 22222222-2222-2222-2222-222222222222
@sessionId = REPLACE_WITH_DEVELOPMENT_SESSION_ID

### DEVELOPMENT_ONLY - API health
GET {{baseUrl}}/health

### DEVELOPMENT_ONLY - API capability flags
GET {{baseUrl}}/v1/info

### DEVELOPMENT_ONLY - Start a material opportunity intake
POST {{baseUrl}}/v1/material-opportunities/start
Content-Type: application/json
x-earth-org-id: {{orgId}}
x-earth-user-id: {{userId}}
x-earth-user-role: OWNER

{
  "idempotencyKey": "development-hdpe-2026-001",
  "materialBatch": {
    "externalReference": "BATCH-2026-001",
    "materialClass": "HDPE_OFFCUTS",
    "quantityKg": 15200,
    "facilityName": "Demo Factory Aarhus",
    "availableFrom": "2026-09-03T12:00:00.000Z"
  },
  "baseline": {
    "disposalCostDkk": 38400,
    "co2eKg": 4800
  },
  "evidence": {
    "documentIds": [],
    "extractionRequested": false
  },
  "dataClassification": "CONFIDENTIAL"
}

### DEVELOPMENT_ONLY - Read one intake session
GET {{baseUrl}}/v1/sessions/{{sessionId}}
x-earth-org-id: {{orgId}}
x-earth-user-id: {{userId}}
x-earth-user-role: OWNER

### DEVELOPMENT_ONLY - Run the next deterministic intake task
POST {{baseUrl}}/v1/sessions/{{sessionId}}/run-next
x-earth-org-id: {{orgId}}
x-earth-user-id: {{userId}}
x-earth-user-role: OWNER

### DEVELOPMENT_ONLY - Read durable intake audit events
GET {{baseUrl}}/v1/sessions/{{sessionId}}/audit-events
x-earth-org-id: {{orgId}}
x-earth-user-id: {{userId}}
x-earth-user-role: OWNER