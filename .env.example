# EARTH — non-secret environment template.
#
# FORBIDDEN: do not put API keys, tokens, passwords, or private URIs in
# any VITE_* variable. Vite inlines VITE_* into the browser JavaScript bundle.
# Adapter secrets live server-side only (apps/api), never in the SPA bundle.

DATABASE_URL=postgres://earth:earth@localhost:5432/earth
PORT=3001

# Optional adapter credentials — server-side / process env only.
# Leave empty. Presence is probed; empty means the adapter stays a stub.
ROBOFLOW_API_KEY=
TINKER_API_KEY=
INKLING_WEIGHTS_URI=
