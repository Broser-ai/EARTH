# EARTH — non-secret environment template.
#
# FORBIDDEN: do not put API keys, tokens, passwords, or private URIs in
# any VITE_* variable. Vite inlines VITE_* into the browser JavaScript bundle.
# Adapter secrets live server-side only (apps/api), never in the SPA bundle.
# OIDC client secrets must never be named VITE_*. Access tokens must not be
# stored in localStorage.

DATABASE_URL=postgres://earth:earth@localhost:5432/earth
PORT=3001

# Auth mode: "development" (local headers, DEVELOPMENT_ONLY) or "oidc".
# Development headers are refused when NODE_ENV=production.
# Default when unset and NODE_ENV is not production: development.
EARTH_AUTH_MODE=development

# Required when EARTH_AUTH_MODE=oidc. No real secrets belong in this file.
# OIDC_ISSUER_URL=https://your-idp.example/
# OIDC_AUDIENCE=earth-api
# Optional. When unset, the API discovers JWKS from {issuer}/.well-known/openid-configuration.
# OIDC_JWKS_URI=https://your-idp.example/oauth/jwks

# Comma-separated browser origins. Default in this template: the Vite app.
# Do not set * — credentials are allowed and a wildcard would be unsafe.
CORS_ORIGINS=http://localhost:5180

# Optional adapter credentials — server-side / process env only.
# Leave empty. Presence is probed; empty means the adapter stays a stub.
ROBOFLOW_API_KEY=
TINKER_API_KEY=
INKLING_WEIGHTS_URI=
